module orders.fulfillment

use orders.model { Outcome, State, Status, Transition }

fn ship(state: State) -> Transition

fn cancel(state: State) -> Transition
    ensures result.outcome != Outcome.Ok or result.state.stock == state.stock + state.quantity
    ensures result.outcome != Outcome.Ok or state.status != Status.Paid or result.state.refunded_cents == state.charged_cents and result.state.refunded_quantity == state.quantity
    ensures result.outcome != Outcome.Ok or state.status != Status.Reserved or result.state.refunded_cents == 0 and result.state.refunded_quantity == 0
