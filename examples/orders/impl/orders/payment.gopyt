module orders.payment

use orders.model { Outcome, State, Status, Transition }

fn pay(state: State) -> Transition
    ensures result.outcome != Outcome.Ok or result.state.charged_cents == state.net_cents + state.tax_cents + state.shipping_cents
{
    invalid_source = state.status != Status.Reserved
    if invalid_source {
        return Transition {
            outcome: Outcome.InvalidState
            state: state
        }
    }
    next_state = State {
        status: Status.Paid
        version: state.version + 1
        stock: state.stock
        quantity: state.quantity
        refunded_quantity: state.refunded_quantity
        net_cents: state.net_cents
        tax_cents: state.tax_cents
        shipping_cents: state.shipping_cents
        charged_cents: state.net_cents + state.tax_cents + state.shipping_cents
        refunded_cents: state.refunded_cents
    }
    return Transition {
        outcome: Outcome.Ok
        state: next_state
    }
}
