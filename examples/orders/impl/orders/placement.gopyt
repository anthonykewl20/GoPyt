module orders.placement

use orders.inventory { reserve }
use orders.model { Command, Outcome, State, Status, Transition }
use orders.pricing { quote }
use orders.validation { valid_order }

fn place(state: State, command: Command) -> Transition
    ensures result.outcome != Outcome.Ok or result.state.stock == state.stock - command.quantity and result.state.quantity == command.quantity
    ensures result.outcome != Outcome.Ok or result.state.charged_cents == 0 and result.state.refunded_cents == 0 and result.state.refunded_quantity == 0
{
    invalid_source = state.status != Status.Empty
    if invalid_source {
        return Transition {
            outcome: Outcome.InvalidState
            state: state
        }
    }
    if not orders.validation.valid_order(command) {
        return Transition {
            outcome: Outcome.InvalidOrder
            state: state
        }
    }
    if command.quantity > state.stock {
        return Transition {
            outcome: Outcome.OutOfStock
            state: state
        }
    }
    quote = orders.pricing.quote(command.quantity, command.unit_cents, command.member)
    next_state = State {
        status: Status.Reserved
        version: state.version + 1
        stock: orders.inventory.reserve(state.stock, command.quantity)
        quantity: command.quantity
        refunded_quantity: state.refunded_quantity
        net_cents: quote.net_cents
        tax_cents: quote.tax_cents
        shipping_cents: quote.shipping_cents
        charged_cents: state.charged_cents
        refunded_cents: state.refunded_cents
    }
    return Transition {
        outcome: Outcome.Ok
        state: next_state
    }
}
