test refunded_is_terminal
{
    placed = orders_multi.service.transition(orders_multi.model.initial(core.map.set[str, i64](core.map.empty[str, i64](), "A", 2)), Command {
        op: "place"
        lines: core.list.append[LineInput](core.list.empty[LineInput](), LineInput {
            sku: "A"
            quantity: 1
            unit_cents: 100
            category: "standard"
        })
        sku: ""
        quantity: 0
        expected_version: 0
        day: 1
        coupon: ""
        tier: "none"
    })
    paid = orders_multi.service.transition(placed.state, Command {
        op: "pay"
        lines: core.list.empty[LineInput]()
        sku: ""
        quantity: 0
        expected_version: 1
        day: 0
        coupon: ""
        tier: "none"
    })
    shipped = orders_multi.service.transition(paid.state, Command {
        op: "ship"
        lines: core.list.empty[LineInput]()
        sku: ""
        quantity: 0
        expected_version: 2
        day: 0
        coupon: ""
        tier: "none"
    })
    refunded = orders_multi.service.transition(shipped.state, Command {
        op: "refund"
        lines: core.list.empty[LineInput]()
        sku: "A"
        quantity: 1
        expected_version: 3
        day: 1
        coupon: ""
        tier: "none"
    })
    core.test.assert_eq(refunded.state.status, Status.Refunded)
    core.test.assert_eq(refunded.state.refunded_cents, 108)
    core.test.assert_eq(refunded.state.charged_cents, 608)
    core.test.assert_eq(refunded.state.shipping_cents, 500)
    again = orders_multi.service.transition(refunded.state, Command {
        op: "refund"
        lines: core.list.empty[LineInput]()
        sku: "A"
        quantity: 1
        expected_version: 4
        day: 1
        coupon: ""
        tier: "none"
    })
    core.test.assert_eq(again.outcome, Outcome.InvalidState)
    core.test.assert_eq(again.state, refunded.state)
    cancel_after = orders_multi.service.transition(refunded.state, Command {
        op: "cancel"
        lines: core.list.empty[LineInput]()
        sku: ""
        quantity: 0
        expected_version: 4
        day: 0
        coupon: ""
        tier: "none"
    })
    core.test.assert_eq(cancel_after.outcome, Outcome.InvalidState)
    return unit
}

test tier_retained_when_later_commands_say_gold
{
    placed = orders_multi.service.transition(orders_multi.model.initial(core.map.set[str, i64](core.map.empty[str, i64](), "A", 5)), Command {
        op: "place"
        lines: core.list.append[LineInput](core.list.empty[LineInput](), LineInput {
            sku: "A"
            quantity: 2
            unit_cents: 3000
            category: "standard"
        })
        sku: ""
        quantity: 0
        expected_version: 0
        day: 1
        coupon: ""
        tier: "member"
    })
    core.test.assert_eq(placed.state.tier, Tier.Member)
    core.test.assert_eq(placed.state.subtotal_cents, 5700)
    core.test.assert_eq(placed.state.shipping_cents, 500)
    paid = orders_multi.service.transition(placed.state, Command {
        op: "pay"
        lines: core.list.empty[LineInput]()
        sku: ""
        quantity: 0
        expected_version: 1
        day: 0
        coupon: ""
        tier: "gold"
    })
    core.test.assert_eq(paid.state.tier, Tier.Member)
    core.test.assert_eq(paid.state.charged_cents, 6670)
    shipped = orders_multi.service.transition(paid.state, Command {
        op: "ship"
        lines: core.list.empty[LineInput]()
        sku: ""
        quantity: 0
        expected_version: 2
        day: 0
        coupon: ""
        tier: "gold"
    })
    core.test.assert_eq(shipped.state.tier, Tier.Member)
    refunded = orders_multi.service.transition(shipped.state, Command {
        op: "refund"
        lines: core.list.empty[LineInput]()
        sku: "A"
        quantity: 2
        expected_version: 3
        day: 20
        coupon: ""
        tier: "gold"
    })
    core.test.assert_eq(refunded.state.tier, Tier.Member)
    core.test.assert_eq(refunded.state.refunded_cents, 6170)
    core.test.assert_eq(refunded.state.day_placed, 1)
    return unit
}

test ship_requires_payment
{
    placed = orders_multi.service.transition(orders_multi.model.initial(core.map.set[str, i64](core.map.empty[str, i64](), "A", 5)), Command {
        op: "place"
        lines: core.list.append[LineInput](core.list.empty[LineInput](), LineInput {
            sku: "A"
            quantity: 1
            unit_cents: 100
            category: "standard"
        })
        sku: ""
        quantity: 0
        expected_version: 0
        day: 0
        coupon: ""
        tier: "none"
    })
    early = orders_multi.service.transition(placed.state, Command {
        op: "ship"
        lines: core.list.empty[LineInput]()
        sku: ""
        quantity: 0
        expected_version: 1
        day: 0
        coupon: ""
        tier: "none"
    })
    core.test.assert_eq(early.outcome, Outcome.InvalidState)
    core.test.assert_eq(early.state, placed.state)
    paid = orders_multi.service.transition(placed.state, Command {
        op: "pay"
        lines: core.list.empty[LineInput]()
        sku: ""
        quantity: 0
        expected_version: 1
        day: 0
        coupon: ""
        tier: "none"
    })
    shipped = orders_multi.service.transition(paid.state, Command {
        op: "ship"
        lines: core.list.empty[LineInput]()
        sku: ""
        quantity: 0
        expected_version: 2
        day: 0
        coupon: ""
        tier: "none"
    })
    core.test.assert_eq(shipped.state.status, Status.Shipped)
    core.test.assert_eq(shipped.state.stock, paid.state.stock)
    core.test.assert_eq(shipped.state.lines, paid.state.lines)
    twice = orders_multi.service.transition(shipped.state, Command {
        op: "ship"
        lines: core.list.empty[LineInput]()
        sku: ""
        quantity: 0
        expected_version: 3
        day: 0
        coupon: ""
        tier: "none"
    })
    core.test.assert_eq(twice.outcome, Outcome.InvalidState)
    return unit
}

test run_sequences_snapshots
{
    request = Request {
        stock: core.map.set[str, i64](core.map.empty[str, i64](), "A", 2)
        commands: core.list.append[Command](core.list.append[Command](core.list.empty[Command](), Command {
            op: "place"
            lines: core.list.append[LineInput](core.list.empty[LineInput](), LineInput {
                sku: "A"
                quantity: 2
                unit_cents: 250
                category: "food"
            })
            sku: ""
            quantity: 0
            expected_version: 0
            day: 2
            coupon: ""
            tier: "none"
        }), Command {
            op: "pay"
            lines: core.list.empty[LineInput]()
            sku: ""
            quantity: 0
            expected_version: 1
            day: 0
            coupon: ""
            tier: "none"
        })
    }
    reply = orders_multi.service.run(request)
    core.test.assert_eq(core.list.len[Snapshot](reply.results), 2)
    second = core.list.get[Snapshot](reply.results, 1)
    second_status = match second {
        none -> ""
        some(snapshot) -> snapshot.status
    }
    core.test.assert_eq(second_status, "paid")
    second_tier = match second {
        none -> ""
        some(snapshot) -> snapshot.tier
    }
    core.test.assert_eq(second_tier, "none")
    second_charge = match second {
        none -> 0
        some(snapshot) -> snapshot.charged_cents
    }
    core.test.assert_eq(second_charge, 1010)
    return unit
}
