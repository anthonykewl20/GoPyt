module orders_multi.customer

use orders_multi.model { Tier }

fn valid_tier(name: str) -> bool

fn tier(name: str) -> Tier

fn tier_name(tier: Tier) -> str

fn discount_rate(tier: Tier) -> i64
    ensures tier != Tier.None or result == 0
    ensures tier != Tier.Member or result == 500
    ensures tier != Tier.Gold or result == 1000

fn discount(gross: i64, tier: Tier) -> i64
    requires gross >= 0
    ensures result == gross * discount_rate(tier) / 10000
