module orders_multi.placement

use orders_multi.model { Command, Line, LineInput, Outcome, State, Status, Transition }

fn place(state: State, command: Command) -> Transition
    ensures result.outcome != Outcome.Ok or orders_multi.validation.valid_order(command, state.stock) and orders_multi.inventory.sufficient(state.stock, command.lines)
    ensures result.outcome != Outcome.Ok or result.state.stock == orders_multi.inventory.reserve_all(state.stock, command.lines)
    ensures result.outcome != Outcome.Ok or result.state.tier == orders_multi.customer.tier(command.tier) and result.state.day_placed == command.day
    ensures result.outcome != Outcome.Ok or result.state.status == Status.Reserved and result.state.charged_cents == 0 and result.state.refunded_cents == 0
    ensures result.outcome != Outcome.Ok or core.list.len[Line](result.state.lines) == core.list.len[LineInput](command.lines) and orders_multi.lines.unrefunded(result.state.lines)
    ensures result.outcome != Outcome.Ok or result.state.subtotal_cents == orders_multi.lines.subtotal(result.state.lines) and result.state.tax_cents == orders_multi.lines.tax_total(result.state.lines)
    ensures result.outcome != Outcome.Ok or result.state.discount_cents == orders_multi.pricing.gross_total(command.lines) - result.state.subtotal_cents
    ensures result.outcome != Outcome.Ok or result.state.shipping_cents == orders_multi.shipping.shipping(result.state.subtotal_cents, core.list.len[Line](result.state.lines), result.state.tier, command.coupon)
